# ===========================
# Dubbing With Your Friends
# .gitignore
# ===========================

# ---- Dependencies ----
node_modules/
.pnp
.pnp.js

# ---- Build outputs ----
.next/
dist/
build/
out/
.turbo/

# ---- Environment variables (NEVER commit these) ----
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Exception: commit the example files
!.env.example

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/

# ---- Testing ----
coverage/
.nyc_output/
playwright-report/
test-results/
playwright/.cache/

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- OS files ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Editors ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---- Supabase ----
supabase/.branches/
supabase/.temp/

# ---- Misc ----
.vercel
.cache/
*.pem
