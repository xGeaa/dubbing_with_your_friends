# Copia este archivo a .env.local y rellena los valores.
# Las NEXT_PUBLIC_* se incrustan en BUILD TIME: al cambiarlas en Vercel
# hay que volver a desplegar para que surtan efecto.

# Backend. En local apunta al servidor de apps/server.
# En Vercel: https://dubbing-with-your-friends.onrender.com (sin barra final)
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Clave pública de Supabase (formato nuevo, sustituye a la antigua anon key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
