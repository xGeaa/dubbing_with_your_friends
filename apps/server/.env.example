# Copia este archivo a .env y rellena los valores.
# `pnpm dev` lo carga con `tsx --env-file=.env`; en Render las variables las
# inyecta la plataforma y este archivo no existe.

PORT=3001

# Origen permitido por CORS y por Socket.io.
# ⚠️ SIN barra final: el header Origin del navegador nunca la lleva y la
# comparación es literal, así que una barra de más rompe CORS en producción.
# En Render: https://dubbing-with-your-friends-web.vercel.app
CLIENT_URL=http://localhost:3000

SUPABASE_URL=https://xxxx.supabase.co
# Clave secreta: salta el RLS. Nunca en el cliente ni en una NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
AUDIO_BUCKET_NAME=audio-recordings
