# Índice de variables de entorno del monorepo.
# Cada app tiene su propio .env.example con más detalle:
#   apps/web/.env.example    → copiar a apps/web/.env.local
#   apps/server/.env.example → copiar a apps/server/.env

# === FRONTEND (apps/web/.env.local) ===
# Las NEXT_PUBLIC_* se incrustan en build time: redeployar tras cambiarlas.
NEXT_PUBLIC_SERVER_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx

# === BACKEND (apps/server/.env) ===
PORT=3001
# Sin barra final (rompe CORS).
CLIENT_URL=http://localhost:3000
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
AUDIO_BUCKET_NAME=audio-recordings

# === PRODUCCIÓN ===
# Vercel (apps/web): NEXT_PUBLIC_SERVER_URL=https://dubbing-with-your-friends.onrender.com
# Render (apps/server): CLIENT_URL=https://dubbing-with-your-friends-web.vercel.app
NODE_ENV=production
